# Published as the plugin repository's own. A clone made with core.autocrlf=true would otherwise
# check plugin/bin/bh out with CRLF, and macOS refuses `#!/bin/sh\r` as a bad interpreter.
* text=auto eol=lf
# Windows runs these; cmd misreads labels in a file with bare LF line endings.
*.cmd text eol=crlf
*.ps1 text eol=crlf
